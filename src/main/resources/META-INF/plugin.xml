<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It cannot be changed between the plugin versions. -->
    <id>io.github.rejeb.tilingblue</id>
    <version>1.0.0</version>

    <name>Tiling Blue</name>
    <category>UI</category>

    <vendor url="https://rejeb.is-a.dev">rbenrejeb</vendor>

    <!-- 2026.2+: Islands UI keys (Island.*); its Java 25 runtime also has the Foreign Function API used for the
         Linux/Wayland title bars. -->
    <idea-version since-build="262"/>

    <description><![CDATA[
        A dark, square-cornered theme that turns the IDE into a set of blue-outlined tiles on a near-black
        background, with red marking whatever has focus. Borrowed from the <em>wargames</em> palette of
        <a href="https://rejeb.is-a.dev">rejeb.is-a.dev</a>.
        <ul>
            <li>UI theme based on Islands Dark: framed tool windows and editor, boxed tabs, red selected tab,
                blue selection, square buttons and popups</li>
            <li>Matching editor color scheme <b>Tiling Blue</b> (syntax, diff, VCS, console, terminal)</li>
            <li>On Linux/Wayland, dialog and welcome-screen title bars are themed too (they are drawn with GTK
                there; the theme restyles them inside the IDE only, without installing a GTK theme)</li>
        </ul>
        For the full look, install IBM Plex Mono and select it as the UI and editor font.
        ]]></description>

    <change-notes><![CDATA[
        Initial release: Tiling Blue UI theme, matching Tiling Blue editor color scheme, and themed
        dialog title bars on Linux/Wayland.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider
                id="566b065c-458c-4106-8861-d1f432b6a40d"
                path="/theme/tilingblue.theme.json"/>
    </extensions>

    <!-- Linux/Wayland dialog title bars (no-op elsewhere): see io.github.rejeb.tilingblue.TitleBars -->
    <applicationListeners>
        <listener class="io.github.rejeb.tilingblue.TitleBars" topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="io.github.rejeb.tilingblue.TitleBars" topic="com.intellij.ide.ui.LafManagerListener"/>
        <listener class="io.github.rejeb.tilingblue.TitleBars" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>
</idea-plugin>
